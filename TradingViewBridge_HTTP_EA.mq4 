//+------------------------------------------------------------------+
//| TradingViewBridge_HTTP_EA.mq4                                    |
//| Receives signals via HTTP from your cloud bridge                 |
//+------------------------------------------------------------------+
#property copyright "TradingView Bridge"
#property version   "1.00"
#property strict

input string   BridgeURL = "https://your-ngrok-url.ngrok.io";
input string   ApiToken = "your-secure-token";
input int      CheckInterval = 5;
input double   DefaultLotSize = 0.1;

string lastSignalId = "";
datetime lastCheck = 0;

int OnInit() {
   Print("HTTP EA Initialized - Connecting to: ", BridgeURL);
   return(INIT_SUCCEEDED);
}

void OnTick() {
   if(TimeCurrent() - lastCheck >= CheckInterval) {
      lastCheck = TimeCurrent();
      CheckForSignals();
   }
}

void CheckForSignals() {
   string headers = "X-Webhook-Token: " + ApiToken + "\r\n";
   string result = WebRequest("GET", BridgeURL + "/api/latest-signal", headers, 5000, NULL);
   
   if(result != "") {
      // Parse and execute trade
      Print("Signal received: ", result);
   }
}
