const express = require('express');
const bodyParser = require('body-parser');
const cors = require('cors');
const fs = require('fs-extra');
const path = require('path');
const http = require('http');
const socketIo = require('socket.io');
const helmet = require('helmet');
const chalk = require('chalk');

const app = express();
const server = http.createServer(app);
const io = socketIo(server, {
  cors: {
    origin: "*",
    methods: ["GET", "POST"]
  }
});

// Configuration
const configPath = path.join(__dirname, 'config.json');
let config = {
  port: 3050,
  secretToken: 'your-secret-token-change-this',
  mt4OutputMethod: 'file', // 'file' or 'http'
  mt4HttpEndpoint: 'http://localhost:8080/webhook',
  mt4DataFolder: path.join(__dirname, 'mt4_data'),
  logRetentionDays: 7,
  enableDebugging: true
};

// Load or create config
if (fs.existsSync(configPath)) {
  config = { ...config, ...fs.readJsonSync(configPath) };
} else {
  fs.writeJsonSync(configPath, config, { spaces: 2 });
}

// Ensure MT4 data directory exists
fs.ensureDirSync(config.mt4DataFolder);

// Store webhook logs
const logsFile = path.join(__dirname, 'webhook_logs.json');
let webhookLogs = [];
if (fs.existsSync(logsFile)) {
  webhookLogs = fs.readJsonSync(logsFile);
}

// Middleware
app.use(helmet({
  contentSecurityPolicy: false
}));
app.use(cors());
app.use(bodyParser.json());
app.use(bodyParser.urlencoded({ extended: true }));
app.use(express.static('public'));

// Authentication middleware for webhooks
const authenticateWebhook = (req, res, next) => {
  const token = req.headers['x-webhook-token'] || req.query.token || req.body.token;
  
  if (!token || token !== config.secretToken) {
    console.log(chalk.red(`[AUTH FAILED] Invalid token from ${req.ip}`));
    return res.status(401).json({ error: 'Invalid or missing token' });
  }
  next();
};

// Helper: Log webhook request
function logWebhook(data, status, error = null) {
  const logEntry = {
    id: Date.now(),
    timestamp: new Date().toISOString(),
    ip: data.ip || 'unknown',
    payload: data.payload,
    status: status,
    error: error,
    forwarded: data.forwarded || false
  };
  
  webhookLogs.unshift(logEntry);
  
  // Keep only last 1000 logs
  if (webhookLogs.length > 1000) {
    webhookLogs = webhookLogs.slice(0, 1000);
  }
  
  fs.writeJsonSync(logsFile, webhookLogs, { spaces: 2 });
  
  // Emit to connected GUI clients
  io.emit('new-log', logEntry);
  
  return logEntry;
}

// Helper: Send signal to MT4 via file
function sendToMT4File(signal) {
  try {
    const timestamp = Date.now();
    const fileName = `signal_${timestamp}.json`;
    const filePath = path.join(config.mt4DataFolder, fileName);
    
    const mt4Signal = {
      timestamp: new Date().toISOString(),
      unixTime: timestamp,
      ...signal,
      processed: false
    };
    
    fs.writeJsonSync(filePath, mt4Signal, { spaces: 2 });
    console.log(chalk.green(`[MT4 FILE] Signal written to: ${fileName}`));
    
    // Also write to current signal file for easier reading
    const currentSignalPath = path.join(config.mt4DataFolder, 'current_signal.json');
    fs.writeJsonSync(currentSignalPath, mt4Signal, { spaces: 2 });
    
    return { success: true, filePath };
  } catch (error) {
    console.log(chalk.red(`[MT4 FILE ERROR] ${error.message}`));
    return { success: false, error: error.message };
  }
}

// Helper: Send signal to MT4 via HTTP
async function sendToMT4HTTP(signal) {
  const axios = require('axios');
  try {
    const response = await axios.post(config.mt4HttpEndpoint, signal, {
      headers: { 'Content-Type': 'application/json' },
      timeout: 5000
    });
    console.log(chalk.green(`[MT4 HTTP] Signal sent successfully`));
    return { success: true, response: response.data };
  } catch (error) {
    console.log(chalk.red(`[MT4 HTTP ERROR] ${error.message}`));
    return { success: false, error: error.message };
  }
}

// Webhook endpoint for TradingView
app.post('/webhook', authenticateWebhook, async (req, res) => {
  const webhookData = {
    ip: req.ip,
    payload: req.body,
    forwarded: false
  };
  
  console.log(chalk.blue('\n═══════════════════════════════════════'));
  console.log(chalk.blue(`📡 WEBHOOK RECEIVED at ${new Date().toISOString()}`));
  console.log(chalk.blue(`📡 From IP: ${req.ip}`));
  console.log(chalk.blue(`📡 Payload: ${JSON.stringify(req.body, null, 2)}`));
  console.log(chalk.blue('═══════════════════════════════════════\n'));
  
  // Validate payload
  let signal = {};
  
  // Extract signal information from various common TradingView formats
  if (req.body.action) {
    // Format from libraries like GBB_lib_webhook [citation:10]
    signal = {
      action: req.body.action,
      symbol: req.body.ticker || req.body.symbol || 'UNKNOWN',
      price: req.body.price || req.body.close || 0,
      quantity: req.body.qty || 1,
      stopLoss: req.body.sl || null,
      takeProfit: req.body.tp || null,
      comment: req.body.comment || '',
      strategy: req.body.strategy || 'TradingView',
      exchange: req.body.exchange || 'UNKNOWN',
      interval: req.body.interval || 'Unknown'
    };
  } else if (req.body.Cross_Alert || req.body.Symbol) {
    // Format from JSON Alert Generation [citation:1]
    signal = {
      action: req.body.Cross_Alert === 'Uptrend' ? 'BUY' : (req.body.Cross_Alert === 'Downtrend' ? 'SELL' : 'UNKNOWN'),
      symbol: req.body.Symbol || req.body.Exchange,
      price: parseFloat(req.body.LTP) || 0,
      fastMA: req.body.Fast_MA,
      slowMA: req.body.Slow_MA,
      comment: `${req.body.Cross_Alert} signal`,
      strategy: 'MA Cross Strategy'
    };
  } else {
    // Generic format - try to guess fields
    signal = {
      action: req.body.signal || req.body.direction || req.body.type || 'UNKNOWN',
      symbol: req.body.symbol || req.body.pair || req.body.market || 'UNKNOWN',
      price: parseFloat(req.body.price) || parseFloat(req.body.close) || parseFloat(req.body.value) || 0,
      quantity: parseFloat(req.body.quantity) || parseFloat(req.body.qty) || 1,
      comment: req.body.comment || req.body.note || '',
      strategy: req.body.strategy || 'Custom'
    };
  }
  
  // Validate required fields
  if (!signal.action || signal.action === 'UNKNOWN') {
    const error = 'Missing or invalid action field (expected BUY/SELL/CLOSE)';
    logWebhook(webhookData, 'REJECTED', error);
    return res.status(400).json({ 
      error: error,
      received: req.body
    });
  }
  
  // Normalize action
  signal.action = signal.action.toUpperCase();
  if (!['BUY', 'SELL', 'CLOSE', 'LONG', 'SHORT'].includes(signal.action)) {
    const error = `Invalid action: ${signal.action}. Expected BUY, SELL, or CLOSE`;
    logWebhook(webhookData, 'REJECTED', error);
    return res.status(400).json({ error: error });
  }
  
  // Map LONG/SHORT to BUY/SELL if needed
  if (signal.action === 'LONG') signal.action = 'BUY';
  if (signal.action === 'SHORT') signal.action = 'SELL';
  
  // Send to MT4
  let mt4Result;
  if (config.mt4OutputMethod === 'file') {
    mt4Result = sendToMT4File(signal);
  } else {
    mt4Result = await sendToMT4HTTP(signal);
  }
  
  if (mt4Result.success) {
    webhookData.forwarded = true;
    logWebhook(webhookData, 'ACCEPTED', null);
    
    console.log(chalk.green(`✅ Signal forwarded to MT4:`));
    console.log(chalk.green(`   Action: ${signal.action}`));
    console.log(chalk.green(`   Symbol: ${signal.symbol}`));
    console.log(chalk.green(`   Price: ${signal.price}`));
    
    res.json({
      status: 'success',
      message: 'Signal received and forwarded to MT4',
      signal: signal,
      mt4Result: mt4Result
    });
  } else {
    logWebhook(webhookData, 'FAILED', mt4Result.error);
    res.status(500).json({
      status: 'error',
      message: 'Failed to forward signal to MT4',
      error: mt4Result.error
    });
  }
});

